# ── Local development overrides ──────────────────────────────────────────────
# Copy this file to .env and fill in the values. Never commit .env.

# Set to 1 to enable Flask debug mode / auto-reload (dev only; default: 0)
FLASK_DEBUG=1

# Secret key used for session signing — must be changed in production
SECRET_KEY=dev-secret-key-change-in-production

# Maximum upload size in MB (default: 5)
MAX_UPLOAD_MB=5

# SQLite database path (default: instance/app.db relative to project root)
# On Render, use a persistent-disk path, e.g. /data/app.db
DATABASE_URL=sqlite:///instance/app.db

# ── Production / Render ───────────────────────────────────────────────────────
# On Render, set these as environment variables in the dashboard:
#   FLASK_DEBUG=0 (or omit — production default)
#   SECRET_KEY=<generated with: python -c "import secrets; print(secrets.token_hex(32))">
#   DATABASE_URL=sqlite:////data/app.db  (persistent disk mounted at /data)
#   MAX_UPLOAD_MB=16
