# Local development overrides.
# Copy this file to .env and fill in the values. Never commit .env.

# Set to 1 to enable Flask debug mode and auto-reload (development only; default: 0)
FLASK_DEBUG=1

# Secret key used for signing. Must be changed in production.
SECRET_KEY=dev-secret-key-change-in-production

# Maximum upload size in MB (default: 5)
MAX_UPLOAD_MB=5

# SQLite database URL (default: instance/app.db relative to the project root)
DATABASE_URL=sqlite:///instance/app.db

# Production on Render: set these as environment variables in the Render dashboard.
#   FLASK_DEBUG=0
#   SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_hex(32))">
#   DATABASE_URL=sqlite:////tmp/app.db   (the free tier disk is temporary)
#   MAX_UPLOAD_MB=5